      ]
    },
    "poqomchi": {
      "langKey": "poqomchi",
      "name": "Poqomchi'",
      "badge": "Alta Verapaz / Baja Verapaz",
      "title": "Xyeeb'al sa' Aatinob'aal Poqomchi'",
      "subtitle": "Síntesis en idioma Poqomchi' sobre el procedimiento de denuncia y protección ciudadana.",
      "speechText": "Chaawil sa' xyanqeb' li xk'anjelal li xboqb'al xq'ilal li moko tiik ta pan qatinamit. Re xyeeb'al li xq'ilal: Xb'een, tawil li xmaak. Xka'pakal, taxik sa' li aatinob'aal 1514 malaj Vigilando. Xrox, tatz'iib'aq resil ut ch'aqab'iiqeb' li hu. Xkaahil, taxakab' li xrajlabil. Chixjunil muqmu ut kolb'il.",
      "stepsHeading": "B'e re Q'orb'al Maak sa' Muqmu pan Kajeeb' Xxik",
      "steps": [
        {
          "num": 1,
          "title": "Xtawab’al li Maak",
          "native": "Xb’een: Xtawab’al",
          "desc": "Tawil ut tatenq’a xk’utb’al li moko tiik ta xkuutuil pan rochoch k’amalb’e."
        },
        {
          "num": 2,
          "title": "Xsaq’ob’al li B’e",
          "native": "Xka’pakal: Xsaq’ob’al",
          "desc": "Tasik’ li aatinob’aal 1514, correo de probidad, malaj sa’ li k’atam Vigilando."
        },
        {
          "num": 3,
          "title": "Xyeechi’ing ut Hu",
          "native": "Xrox: Xyeechi’ing",
          "desc": "Tatz’iib’aq resil ut tawakliqeb’ li xhuulil o xfotoyil li xmaak."
        },
        {
          "num": 4,
          "title": "Xmuqik li Rajlabil",
          "native": "Xkaahil: Rajlabil muqmu",
          "desc": "Tak’atqaliq li xrajlabil xbaatxeb’al re xraqb’al sa’ muqmuil."
        }
      ],
      "guaranteesTitle": "Muqmuil ut Kolb'al re CNC",
      "guarantees": [
        {
          "icon": "fa-user-secret",
          "title": "Muqmu ut Tz’aqal Kolb’il",
          "desc": "Inc’a na’ajtaman aa k’ab’a’ re xyeeb’al li xmaak."
        },
        {
          "icon": "fa-shield-alt",
          "title": "Xkolb’al li Ajyeel Maak",
          "desc": "Tenq’al chaq’rab’il re inc’a’ tatz’eq’te’q pan k’anjel."
        },
        {
          "icon": "fa-clock",
          "title": "K’anjelal Rajlal K’utan (24/7)",
          "desc": "Li k’atam Vigilando wank sa’ k’unjil rajlal k’utan."
        }
      ],
      "glossaryTitle": "Ahtinob'al pan Poqomchi' Tzij",
      "glossary": [
        {
          "termEs": "Corrupción",
          "maya": "Moko tiik ta xkuutuil",
          "speech": "Moko tiik ta: Xk’anjelajisinkil li awab’ejiik sa’ moko tiik ta."
        },
        {
          "termEs": "Probidad",
          "maya": "Tiikilal pan k’anjel",
          "speech": "Tiikilal: K’anjelak sa’ tiikilal ut sa’ saqenil."
        },
        {
          "termEs": "Denuncia",
          "maya": "Q’orb’al maak",
          "speech": "Q’orb’al maak: Xboqb’al ut xyeeb’al li maak b’anbil."
        },
        {
          "termEs": "Servidor Público",
          "maya": "Aj k’anjel re tinamit",
          "speech": "Aj k’anjel: Li poyanam na k’anjelak sa’ awab’ejil."
        },
        {
          "termEs": "Transparencia",
          "maya": "Saqilal",
          "speech": "Saqilal: Xk’utb’al chixjunil pan saqilal chiru tenamit."
        }
      ]
    }
  },
