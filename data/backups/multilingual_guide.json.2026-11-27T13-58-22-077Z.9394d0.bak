    "tzutujil": {
      "langKey": "tzutujil",
      "name": "Tz'utujil",
      "badge": "Sololá / Suchitepéquez",
      "title": "Utatab'exik ri tz'ijob'al pa Tz'utujil",
      "subtitle": "Síntesis hablada en Tz'utujil sobre canales de denuncia e integridad pública.",
      "speechText": "Utzilaj peik pa ri chak patan re ri CNC. Re ujikorisaxik ri itzel b'anob'al pa ri qatinamit: Nab'ey, chaweta'maj ri mac. Ruka'n, cha'o ri b'e achi'el ri 1514 o Vigilando. Rox, tz'ibaj ronojel xukuje' ya'o ri wujil. Rukaj, k'olowa ri retal ujujal. Konojel ri q'alajisanik e ebal xukuje' chajin.",
      "stepsHeading": "B'eyal Q'alajisanik Jikomal pa Kaji' Taqim",
      "steps": [
        {
          "num": 1,
          "title": "Eta’manik re ri Mac",
          "native": "Nab’ey: Eta’manik",
          "desc": "Chaweta’maj ri itzel b’anob’al o mac xutir pa ri rochoch k’amal b’ey."
        },
        {
          "num": 2,
          "title": "Cha’oj re ri B’e",
          "native": "Ruka’n: Cha’oj b’e",
          "desc": "Cha’o ri b’e utz: Ch’a’wibal 1514, correo de probidad, o ri plataforma Vigilando."
        },
        {
          "num": 3,
          "title": "Wujil xukuje’ Pruebas",
          "native": "Rox: Wujil q’alajisabal",
          "desc": "Tz’ib’aj ronojel ri xbanik xukuje’ ya’o ri wujil o wachbal chi rij ri mac."
        },
        {
          "num": 4,
          "title": "Retal Chajinik",
          "native": "Rukaj: Retal ewäl",
          "desc": "K’olowa ri rajilajuj retal rech katkunik katz’onoj pa ewäl."
        }
      ],
      "guaranteesTitle": "Jikomal Ewäl chuqa' Ruchajixik CNC",
      "guarantees": [
        {
          "icon": "fa-user-secret",
          "title": "100% Ewäl xukuje’ Maj Bi’aj",
          "desc": "Man k’atzin ta kaya’ ri abi’ we xiw kak’utuj ri chajinik."
        },
        {
          "icon": "fa-shield-alt",
          "title": "Ruchajixik Ajq’alajisal",
          "desc": "Garantías rech chajinik k’aslemal xukuje’ chak patan."
        },
        {
          "icon": "fa-clock",
          "title": "Chak Ronojel Q’ij (24/7)",
          "desc": "Tzijim ri k’atel pa internet Vigilando la Integridad."
        }
      ],
      "glossaryTitle": "Soltzij pa Tz'utujil Tzijob'al",
      "glossary": [
        {
          "termEs": "Corrupción",
          "maya": "Itzel b’anob’al",
          "speech": "Itzel b’anob’al: Ri uq’ab’alisaxik ri chak pa itzelal."
        },
        {
          "termEs": "Probidad",
          "maya": "Choojilal",
          "speech": "Choojilal: B’anob’al pa saqilal xukuje’ choojilal."
        },
        {
          "termEs": "Denuncia",
          "maya": "Q’alajisanik",
          "speech": "Q’alajisanik: Ya’ik b’ixik chi rij ri mac o itzel b’anob’al."
        },
        {
          "termEs": "Servidor Público",
          "maya": "Samajel re amaq’",
          "speech": "Samajel re amaq’: Jun winaq kachakun pa ri rochoch k’amal b’ey."
        },
        {
          "termEs": "Transparencia",
          "maya": "Saqilal",
          "speech": "Saqilal: Tz’etbal re ronojel ri chak rech ri k’amal b’ey."
