# PIA - configuración de instalación
# Copiar como .env y completar antes de iniciar el servidor.

NODE_ENV=production
PORT=3000

# Ruta persistente de datos privados (fuera de los archivos públicos).
# Windows: C:/PIA_Data
# Linux: /var/lib/pia/data
# PIA_DATA_DIR=C:/PIA_Data   (Windows)
# PIA_DATA_DIR=/var/lib/pia/data   (Linux; Docker ya lo configura)

# Generar una clave aleatoria propia de al menos 64 caracteres.
# No reutilizar esta plantilla ni publicar el valor real.
PIA_SESSION_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES

# Credenciales de inicialización: solo se usan cuando aún no existe users_roles.json.
# Definir contraseñas distintas, robustas y retirar estas variables después del primer arranque.
PIA_OPERATOR_1_PASSWORD=
PIA_OPERATOR_2_PASSWORD=

# Cuentas autorizadas fijas para el entorno institucional.
PIA_OPERATOR_1_EMAIL=deteccionydenuncia@cnc.gob.gt
PIA_OPERATOR_1_NAME=Dirección de Apoyo en la Gestión de Irregularidades - DAGI
PIA_OPERATOR_2_EMAIL=apoyogi@cnc.gob.gt
PIA_OPERATOR_2_NAME=Apoyo a la Gestión de Irregularidades (CNC)

# Firebase Authentication (opcional, si se habilita autenticación federada).
FIREBASE_PROJECT_ID=pia-portal-integridad
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=pia-portal-integridad.firebaseapp.com
FIREBASE_APP_ID=

# Asistente Lupita. Si queda vacío, debe utilizar el mecanismo de contingencia.
GEMINI_API_KEY=
