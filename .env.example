# ==============================================================================
# Portal de Integridad Activa (PIA) - Plantilla de Variables de Entorno (.env)
# Comisión Nacional contra la Corrupción (CNC) - Organismo Ejecutivo de Guatemala
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR Y ENTORNO DE EJECUCIÓN
# ------------------------------------------------------------------------------
# Puerto de escucha del servicio (utilizado por Flask / Gunicorn o Node.js)
PORT=3000
ENVIRONMENT=production
FLASK_ENV=production

# Clave secreta para la firma criptográfica HMAC-SHA256 de tokens de sesión
# IMPORTANTE: Reemplazar por una cadena aleatoria de al menos 64 caracteres en producción
PIA_SESSION_SECRET=CAMBIAR_POR_LLAVE_SECRETA_ALEATORIA_CRIPTOGRAFICAMENTE_SEGURA_2026

# ------------------------------------------------------------------------------
# 2. ALMACENAMIENTO PERSISTENTE Y RESPALDOS
# ------------------------------------------------------------------------------
# Directorio local seguro para almacenar bases de datos JSON, bitácoras y respaldos
# En Linux: /var/lib/pia/data o ./data
# En Windows Server: C:\PIA_Data
PIA_DATA_DIR=./data

# ------------------------------------------------------------------------------
# 3. IDENTIDADES INSTITUCIONALES AUTORIZADAS (EXCLUSIVO PARA 2 OPERADORES)
# ------------------------------------------------------------------------------
# Cuentas oficiales restringidas de la Comisión Nacional contra la Corrupción
PIA_OPERATOR_1_EMAIL=deteccionydenuncia@cnc.gob.gt
PIA_OPERATOR_1_NAME=Dirección de Apoyo en la Gestión de Irregularidades - DAGI

PIA_OPERATOR_2_EMAIL=apoyogi@cnc.gob.gt
PIA_OPERATOR_2_NAME=Apoyo a la Gestión de Irregularidades (CNC)

# ------------------------------------------------------------------------------
# 4. INTELIGENCIA ARTIFICIAL - ASISTENTE VIRTUAL LUPITA
# ------------------------------------------------------------------------------
# Clave de API de Google Gemini (generada en Google Cloud Console para la CNC)
# Si se deja vacía, Lupita opera en modo contingencia con su motor de respuestas heurísticas oficiales
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. CONFIGURACIÓN FIREBASE AUTHENTICATION (OPCIONAL / HÍBRIDO)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=pia-portal-integridad
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=pia-portal-integridad.firebaseapp.com
FIREBASE_APP_ID=
