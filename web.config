<?xml version="1.0" encoding="utf-8"?>
<!-- ========================================================
     Portal de Integridad Activa (PIA) - Gobierno de Guatemala
     Configuración para Servidor Físico con Windows Server e IIS
     Modos soportados:
       1. IIS con Reverse Proxy (Application Request Routing - ARR + URL Rewrite) -> RECOMENDADO
       2. IIS con módulo iisnode
     ======================================================== -->
<configuration>
  <system.webServer>
    
    <!-- 1. Encabezados de Seguridad y Supresión de Telemetría -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="Server" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(self), geolocation=()" />
      </customHeaders>
    </httpProtocol>

    <!-- 2. Filtro Estricto de Peticiones: Bloqueo de archivos sensibles y secretos -->
    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".github" />
          <add segment=".env" />
          <add segment=".env.example" />
          <add segment="node_modules" />
          <add segment="authorized_operators.json" />
          <add segment="audit_logs.json" />
          <add segment="users_roles.json" />
          <add segment="page_visits.json" />
          <add segment="chatbot_conversations.json" />
          <add segment="security_policies.json" />
          <add segment="data" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".tmp" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- 3. Tipos MIME Estáticos -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <!-- 4. Reglas de Enrutamiento y Reescritura de URL -->
    <rewrite>
      <rules>
        <!-- Redirección Forzada a HTTPS en Producción (Opcional, descomentar al instalar certificado SSL) -->
        <!--
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        -->

        <!-- Enrutamiento hacia el servicio Node.js institucional (127.0.0.1:3000) -->
        <rule name="ReverseProxyToNodeService" stopProcessing="true">
          <match url="^(api/.*|admin.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:0}" />
        </rule>

        <!-- Servir archivos estáticos del portal si existen físicamente -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Redirección de directorios a slash final -->
        <rule name="DirectoryTrailingSlash" stopProcessing="true">
          <match url="^(canales-por-la-integridad|directorio|gobierno_en_numeros|riesgo)$" />
          <action type="Redirect" url="{R:1}/" redirectType="Permanent" />
        </rule>

        <!-- Redirección general restante a Node.js -->
        <rule name="AllOtherToNode" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:0}" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
