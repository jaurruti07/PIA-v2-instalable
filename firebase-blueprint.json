{
  "entities": {
    "admin_audit_log": {
      "title": "Registro de Auditoría de Operador",
      "description": "Bitácora inmutable de acciones realizadas por los dos operadores autorizados",
      "type": "object",
      "properties": {
        "user": {
          "type": "string",
          "description": "Correo institucional del operador"
        },
        "uid": {
          "type": "string",
          "description": "UID inmutable de Firebase Auth"
        },
        "action": {
          "type": "string",
          "description": "Acción administrativa ejecutada"
        },
        "module": {
          "type": "string",
          "description": "Módulo afectado"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora ISO"
        },
        "ip": {
          "type": "string",
          "description": "Dirección IP origen"
        }
      },
      "required": ["user", "uid", "action", "module", "timestamp"]
    }
  },
  "firestore": {
    "/admin_audit_logs/{logId}": {
      "schema": "admin_audit_log",
      "description": "Registros de auditoría de los dos operadores del Organismo Ejecutivo"
    }
  }
}
